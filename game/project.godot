; Engine configuration file.
; CoreDive Challenge - v1 (biome 1 jouable)

config_version=5

[application]

config/name="CoreDive Challenge"
config/description="Roguelite 2D pixel art - plonge vers le Noyau. v1 : biome 1, combat de base, boss 1."
config/version="0.2.1"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

JoyMap="*res://scripts/joymap.gd"
AudioManager="*res://scripts/audio.gd"
Dev="*res://scripts/dev.gd"
RunState="*res://scripts/run_state.gd"
MetaState="*res://scripts/meta_state.gd"
SaveManager="*res://scripts/save_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=0
window/stretch/mode="viewport"
window/stretch/aspect="keep"

